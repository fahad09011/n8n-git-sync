    {
      "parameters": {
        "jsCode": "const data = $json.final_data;\n\n// First object contains title, hook, and CTA\nconst metadata = data.find(item =>\n  item.title || item.hook || item.cta\n);\n\nconst videos = data\n  .filter(item => item.video_url)\n  .sort((a, b) => a.scene_number - b.scene_number)\n  .map(item => ({\n    scene_number: item.scene_number,\n    video_url: item.video_url,\n    caption: item.caption\n  }));\n\nconst audio = data.find(item => item.audio);\n\nreturn [\n  {\n    json: {\n      title: metadata?.title ?? null,\n      hook: metadata?.hook ?? null,\n      cta: metadata?.cta ?? null,\n      script: metadata?.script ?? null,\n\n      videos,\n\n      audio_url: audio?.audio?.url ?? null\n    }\n  }\n];"
      },
